# URL where TrailTales is running.
# For a local Docker run:   http://localhost:5000
# For your EC2 deployment:  http://YOUR_EC2_IP:5000
BASE_URL=http://localhost:5173

# Set HEADLESS=false if you want to watch the browser run the tests.
HEADLESS=false

# Browser to use: chrome (default) or firefox
BROWSER=chrome
